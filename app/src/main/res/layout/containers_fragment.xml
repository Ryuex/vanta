<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorPrimarySurface"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingTop="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="16dp">

        <TextView
            style="@style/VantaSectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="4dp"
            android:text="@string/containers" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/containers_subtitle"
            android:textColor="?attr/colorSecondaryText"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/ETSearchContainers"
            style="@style/VantaSearchField"
            android:layout_marginTop="14dp"
            android:hint="@string/search_containers"
            android:inputType="text"
            android:singleLine="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/BTFilterAll"
                style="@style/VantaChip"
                android:layout_marginRight="6dp"
                android:text="@string/filter_all" />

            <TextView
                android:id="@+id/BTFilterFavorites"
                style="@style/VantaChip"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"
                android:text="@string/filter_favorites" />

            <TextView
                android:id="@+id/BTFilterRecent"
                style="@style/VantaChip"
                android:layout_marginLeft="6dp"
                android:text="@string/filter_recent" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/BTNewContainer"
            style="@style/VantaPrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:drawableStart="@drawable/icon_add"
            android:drawableTint="@color/vanta_text_primary"
            android:drawablePadding="8dp"
            android:text="@string/new_container" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/RecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="2dp"
            android:paddingBottom="16dp"
            android:scrollbars="vertical"
            app:layoutManager="LinearLayoutManager" />

        <LinearLayout
            android:id="@+id/TVEmptyText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/vanta_icon_tile"
                android:contentDescription="@string/app_name"
                android:padding="14dp"
                android:src="@drawable/vanta_mark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:id="@+id/TVEmptyTitle"
                android:text="@string/empty_containers_title"
                android:textColor="?attr/colorPrimaryText"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:id="@+id/TVEmptyDescription"
                android:gravity="center"
                android:text="@string/empty_containers_description"
                android:textColor="?attr/colorSecondaryText"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
