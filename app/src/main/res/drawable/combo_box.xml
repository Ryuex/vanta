<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/vanta_primary_ripple">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="?attr/colorSecondarySurface" />
                    <stroke android:width="1dp" android:color="?attr/colorSecondaryVariant" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item
                android:drawable="@drawable/vanta_spinner_chevron"
                android:gravity="right|center_vertical"
                android:right="8dp" />
        </layer-list>
    </item>
</ripple>
